+bool env_mac(std::vector<uint8_t>& out) {
+    const char* raw = std::getenv("IPATOOL_MAC");
+    if (!raw || !*raw) return false;
+
+    std::string value;
+    for (const unsigned char* p = reinterpret_cast<const unsigned char*>(raw); *p; ++p) {
+        if (*p == ':' || *p == '-' || std::isspace(*p)) continue;
+        if (!std::isxdigit(*p)) return false;
+        value.push_back(static_cast<char>(*p));
+    }
+    if (value.size() != 12) return false;
+
+    out.resize(6);
+    for (size_t i = 0; i < out.size(); ++i) {
+        auto hex = [](char c) -> uint8_t {
+            if (c >= '0' && c <= '9') return static_cast<uint8_t>(c - '0');
+            if (c >= 'a' && c <= 'f') return static_cast<uint8_t>(c - 'a' + 10);
+            return static_cast<uint8_t>(c - 'A' + 10);
+        };
+        out[i] = static_cast<uint8_t>((hex(value[i * 2]) << 4) | hex(value[i * 2 + 1]));
+    }
+    return !is_placeholder_mac(out.data(), out.size());
+}
+
+bool env_mac_requested() {
+    const char* raw = std::getenv("IPATOOL_MAC");
+    return raw && *raw;
+}
